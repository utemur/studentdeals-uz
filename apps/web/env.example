# Environment
NODE_ENV=development

# Base URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntryu_...
SENTRY_ORG=studentdeals
SENTRY_PROJECT=studentdeals-uz
NEXT_PUBLIC_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DEBUG=false

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# App Configuration
NEXT_PUBLIC_APP_NAME=StudentDeals.uz
NEXT_PUBLIC_APP_VERSION=0.1.0

# Production URLs (replace in production)
# NEXT_PUBLIC_BASE_URL=https://studentdeals.uz
# NEXT_PUBLIC_API_URL=https://api.studentdeals.uz
# NODE_ENV=production
# NEXT_PUBLIC_ENVIRONMENT=production

