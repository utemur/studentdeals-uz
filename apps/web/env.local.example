# API Configuration
# Copy this file to .env.local and adjust values as needed

# Production API URL (default for local development)
NEXT_PUBLIC_API_URL=https://studentdeals-api.onrender.com

# For local API testing, uncomment the line below:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# For staging environment:
# NEXT_PUBLIC_API_URL=https://api-staging.studentdeals.uz

# Environment setup:
# 1. Local development: Use production API (default)
# 2. Local API testing: Set NEXT_PUBLIC_API_URL=http://localhost:3001
# 3. Production: Set in Vercel environment variables