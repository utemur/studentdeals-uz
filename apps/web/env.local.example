# Environment (development | staging | production)
NEXT_PUBLIC_ENV=development

# API URL (optional - auto-resolved based on NEXT_PUBLIC_ENV if not set)
# Development: http://localhost:3001 (default)
# Staging: https://api-staging.studentdeals.uz
# Production: https://studentdeals-uz.onrender.com
NEXT_PUBLIC_API_URL=

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=studentdeals-web
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ENVIRONMENT=development
