# Environment (development | staging | production)
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@host:port/database?sslmode=require"

# JWT
JWT_SECRET="your-secret-key-change-in-production"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="StudentDeals <noreply@studentdeals.uz>"
# Development: http://localhost:3000
# Staging: https://staging.studentdeals.uz
# Production: https://studentdeals.uz
APP_URL="http://localhost:3000"
EMAIL_TOKEN_TTL_HOURS=24

# Sentry (Error Monitoring)
SENTRY_DSN="https://...@sentry.io/..."

# Server
PORT=3001