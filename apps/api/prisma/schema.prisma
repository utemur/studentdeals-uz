// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                String                   @id @default(cuid())
  email             String                   @unique
  passwordHash      String
  role              UserRole                 @default(USER)
  emailVerifiedAt   DateTime?
  // Telegram bot verification timestamp
  // This field is set by the Telegram bot when a user completes registration
  // Users can only log in on the website if this field is set (not null)
  telegramVerifiedAt DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tokens            EmailVerificationToken[]
  feedback          Feedback[]

  // Indexes for performance
  @@index([email]) // Redundant but explicit for clarity
  @@index([role]) // For finding users by role
  @@index([emailVerifiedAt]) // For finding verified/unverified users
  @@index([telegramVerifiedAt]) // For finding users verified via Telegram bot
  @@index([createdAt]) // For user analytics and pagination
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([userId]) // For finding tokens by user
  @@index([token]) // Redundant but explicit for clarity
  @@index([expiresAt]) // For cleanup of expired tokens
  @@index([usedAt]) // For finding used/unused tokens
  @@index([userId, expiresAt]) // Composite: user's active tokens
  @@index([userId, usedAt]) // Composite: user's token usage
  @@map("email_verification_tokens")
}

model Feedback {
  id        String    @id @default(cuid())
  userId    String?   // Nullable - allow anonymous feedback
  email     String?   // Email for beta feedback (optional)
  rating    Int?      // 1-5 star rating (nullable)
  message   String    // Required message (5-2000 chars)
  page      String?   // Page/context where feedback was submitted
  userAgent String?   // Browser/device info
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes for performance
  @@index([userId]) // For finding feedback by user
  @@index([email]) // For finding feedback by email
  @@index([rating]) // For analytics by rating
  @@index([createdAt]) // For chronological queries
  @@index([userId, createdAt]) // Composite: user's feedback over time
  @@map("feedback")
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameRu    String
  nameUz    String
  icon      String?
  descriptionRu String?
  descriptionUz String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands    Brand[]

  // Indexes for performance
  @@index([slug]) // For finding category by slug
  @@index([isActive]) // For filtering active categories
  @@index([order]) // For ordering categories
  @@map("categories")
}

model Brand {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String   @unique
  description String?
  logoUrl     String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Indexes for performance
  @@index([slug]) // For finding brand by slug
  @@index([name]) // For finding brand by name
  @@index([categoryId]) // For filtering brands by category
  @@map("brands")
}
