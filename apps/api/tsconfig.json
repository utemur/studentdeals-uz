{
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "types": ["node"],
    "lib": ["ES2020"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
