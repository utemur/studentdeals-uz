{
  "name": "studentdeals-uz",
  "version": "1.0.0",
  "private": true,
  "description": "Student Deals Uzbekistan - Turborepo monorepo",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:web": "pnpm dev --filter web",
    "build:web": "pnpm build --filter web",
    "dev:api": "pnpm dev --filter api",
    "build:api": "pnpm build --filter api",
    "start:api": "pnpm start --filter api",
    "prisma:studio": "pnpm --filter api dlx prisma studio"
  },
  "devDependencies": {
    "turbo": "^1.12.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
