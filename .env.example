# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend (https://resend.com) — used to send magic-link sign-in emails
RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="onboarding@resend.dev"

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me"

# Base URL the app is served from (used to build magic-link URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
